@@ -15,6 +15,8 @@ import java.util.Optional;
 import java.util.Set;
 import java.util.stream.Collectors;
 import java.util.stream.Stream;
+
+import io.papermc.paper.event.inventory.ItemCraftedEvent;
 import io.papermc.paper.adventure.PaperAdventure;
 import io.papermc.paper.block.bed.BedEnterProblem;
 import io.papermc.paper.connection.HorriblePlayerLoginEventHack;
@@ -1434,6 +1436,18 @@ public class CraftEventFactory {
     }
 
     // Paper start
+
+    public static ItemCraftedEvent callItemCraftedEvent(CraftingContainer matrix, Container resultInventory, ItemStack result, InventoryView lastCraftView, Player player) {
+        CraftInventoryCrafting inventory = new CraftInventoryCrafting(matrix, resultInventory);
+        org.bukkit.inventory.ItemStack resultStack = CraftItemStack.asCraftMirror(result);
+        inventory.setResult(resultStack);
+
+        ItemCraftedEvent event = new ItemCraftedEvent(inventory, lastCraftView, player, resultStack);
+        Bukkit.getPluginManager().callEvent(event);
+
+        return event;
+    }
+    
