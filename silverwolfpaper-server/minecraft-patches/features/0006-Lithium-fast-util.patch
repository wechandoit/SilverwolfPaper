@@ -79,6 +79,11 @@ public enum Direction implements StringRepresentable, ca.spottedleaf.moonrise.pa
     private int stepY;
     private int stepZ;
 
+    // SW start - Lithium - fast util
+    public static final Direction[] VERTICAL = {Direction.DOWN, Direction.UP};
+    public static final Direction[] HORIZONTAL = {Direction.WEST, Direction.EAST, Direction.NORTH, Direction.SOUTH};
+    // SW end - Lithium - fast util
+
     private Quaternionf getRotationUncached() {
         switch ((Direction)(Object)this) {
             case DOWN: {
@@ -225,7 +230,7 @@ public enum Direction implements StringRepresentable, ca.spottedleaf.moonrise.pa
     }
 
     public Direction getOpposite() {
-        return this.opposite; // Paper - optimise collisions
+        return VALUES[this.oppositeIndex]; // SW - Lithium - fast util
     }
 
     public Direction getClockWise(Direction.Axis axis) {
@@ -357,7 +362,7 @@ public enum Direction implements StringRepresentable, ca.spottedleaf.moonrise.pa
     }
 
     public static Direction getRandom(RandomSource random) {
-        return Util.getRandom(VALUES, random);
+        return VALUES[random.nextInt(VALUES.length)]; // SW - Lithium - fast util
     }
 
     public static Direction getApproximateNearest(double x, double y, double z) {
diff --git a/net/minecraft/world/phys/AABB.java b/net/minecraft/world/phys/AABB.java
index 7f0ff1bf4ddf7bfe1d3cad472416dd032806066b..e96b98d455c7cc038a9603ae07e4c609d668899c 100644
--- a/net/minecraft/world/phys/AABB.java
+++ b/net/minecraft/world/phys/AABB.java
@@ -19,6 +19,15 @@ public class AABB {
     public final double maxY;
     public final double maxZ;
 
+    // SW start - Lithium - fast util
+    static {
+        assert Direction.Axis.X.ordinal() == 0;
+        assert Direction.Axis.Y.ordinal() == 1;
+        assert Direction.Axis.Z.ordinal() == 2;
+        assert Direction.Axis.values().length == 3;
+    }
+    // SW end - Lithium - fast util
+
     public AABB(double x1, double y1, double z1, double x2, double y2, double z2) {
         this.minX = Math.min(x1, x2);
         this.minY = Math.min(y1, y2);
@@ -80,11 +89,25 @@ public class AABB {
     }
 
     public double min(Direction.Axis axis) {
-        return axis.choose(this.minX, this.minY, this.minZ);
+        // SW start - Lithium - fast util
+        return switch (axis.ordinal()) {
+            case 0 -> this.minX;
+            case 1 -> this.minY;
+            case 2 -> this.minZ;
+            default -> throw new IllegalArgumentException();
+        };
+        // SW end - Lithium - fast util
     }
 
     public double max(Direction.Axis axis) {
-        return axis.choose(this.maxX, this.maxY, this.maxZ);
+        // SW start - Lithium - fast util
+        return switch (axis.ordinal()) {
+            case 0 -> this.maxX;
+            case 1 -> this.maxY;
+            case 2 -> this.maxZ;
+            default -> throw new IllegalArgumentException();
+        };
+        // SW end - Lithium - fast util
     }
 
     @Override
